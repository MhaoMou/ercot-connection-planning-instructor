# Python caches and local environments
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
venv/
env/
*.egg-info/

# macOS/editor noise
.DS_Store
.idea/
.vscode/

# Local databases, logs, and temporary outputs
*.db
*.sqlite
*.sqlite3
*.log
outputs/
work/
.superpowers/
docs/superpowers/

# LaTeX build products; keep the source, bibliography, README, and PDF.
docs/student_manual/*.aux
docs/student_manual/*.bbl
docs/student_manual/*.blg
docs/student_manual/*.fdb_latexmk
docs/student_manual/*.fls
docs/student_manual/*.out
docs/student_manual/*.synctex.gz
docs/student_manual/*.toc

# Student tutorial build products; source prompts/transcripts remain tracked.
docs/student_tutorial/generated/
docs/student_tutorial/build/
docs/student_tutorial/*.aux
docs/student_tutorial/*.bbl
docs/student_tutorial/*.blg
docs/student_tutorial/*.fdb_latexmk
docs/student_tutorial/*.fls
docs/student_tutorial/*.out
docs/student_tutorial/*.synctex.gz
docs/student_tutorial/*.toc
docs/student_tutorial/*.pdf

# Raw downloads and large source artifacts. Obtain raw datasets through the
# documented provenance steps rather than committing local downloads.
data/raw/*
!data/raw/README.md
!data/raw/ercot_hourly_load/
!data/raw/ercot_hourly_load/README.md
data/raw/ercot_hourly_load/*.zip
!data/raw/*metadata*.json
data/processed/texas_dispatch_source_v1/demand_bus.csv
# Rebuildable year-specific expansions are intentionally not committed. They
# are hundreds of MB each; the normalized zone inputs and builder are tracked.
data/processed/texas_dispatch_source_v1_years/
!data/processed/texas_dispatch_source_v1_years/.gitkeep

# Local generated batch/evaluation results; the sanitized web package is
# intentionally tracked under web/data/results/.
